# Copy to .env.local for local dev; on Vercel add these under Project > Settings > Environment Variables.
# Never commit real values.

# --- Supabase (required for /crm and /admin) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by webhooks/ICS feed and the BES admin. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Lead Engine (/crm) ---
# Business time zone for "today", meeting slots and dashboards (IANA name).
CRM_TIMEZONE=Asia/Dubai
# Optional: 24+ random characters to enable the read-only calendar feed /api/crm/calendar?token=...
CRM_ICS_TOKEN=
# Optional: Google Calendar push sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- BES site (existing features) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TEAM_NOTIFICATION_EMAIL=
GEMINI_API_KEY=
GEMINI_MODEL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
